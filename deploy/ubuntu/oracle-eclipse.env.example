# Copy this file to /etc/oracle-eclipse/oracle-eclipse.env, set mode 600,
# and replace every value marked CHANGE_ME. Do not store the real file in Git.

ORACLE_APP_VERSION=1.0.0

DASHSCOPE_API_KEY=CHANGE_ME
ORACLE_RESEARCH_USERNAME=CHANGE_ME
ORACLE_RESEARCH_PASSWORD=CHANGE_ME
ORACLE_PUBLIC_CORS_ORIGIN=https://demo.example.com

QWEN_MODEL=qwen-plus
QWEN_OCR_MODEL=qwen-vl-ocr-latest
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
QWEN_REQUEST_TIMEOUT=180

# Alibaba Cloud DashScope HappyHorse model used for asynchronous playable MP4 generation.
# Test mode produces five 3-second, 640x360 clips; formal mode is not implemented yet.
QWEN_VIDEO_MODEL=happyhorse-1.1-t2v
# FFmpeg is required to join multi-segment storyboards longer than 10 seconds.
# ORACLE_FFMPEG_BIN=/usr/bin/ffmpeg
# Maximum wait for one video task, in seconds (60-900).
QWEN_VIDEO_TIMEOUT=900
# Optional persistent directory for private generated MP4 files.
# ORACLE_VIDEO_ASSET_DIR=/var/lib/oracle-eclipse/video

ORACLE_SECURE_COOKIES=1
ORACLE_TRUST_PROXY=1
ORACLE_RESEARCH_SESSION_HOURS=4
ORACLE_LOGIN_RATE_LIMIT=10
ORACLE_PUBLIC_CHAT_RATE_LIMIT=30
# Public demo only: show a passwordless one-click research-workbench entry.
# Local loopback research mode shows this entry automatically when credentials exist.
# Keep disabled for normal public deployments.
ORACLE_QUICK_LOGIN_ENABLED=0

# Optional: enable enhanced PPTX download after Node.js and the artifact
# export module have been installed on the server.
# ORACLE_NODE_BIN=/usr/bin/node
# ORACLE_ARTIFACT_TOOL_MODULE=/absolute/path/to/artifact_tool.mjs
